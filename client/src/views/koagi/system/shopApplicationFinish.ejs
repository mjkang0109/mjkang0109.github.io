---
group: system
state:
    default: 가든샵신청-완료-백두
    sejong: 가든샵신청-완료-세종
    garden: 가든샵신청-완료-정원
    native: 가든샵신청-완료-자생
---
<!DOCTYPE html>
<html lang="ko">
<%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_constants`, {

}) %>
<head>
    <%
    currentName = CATEGORY_KO.get(state);
    currentCategory = 'system';
    currentNav = CATEGORY_EN.get(state);
    imgPath = `${process.env.IMG_PATH}/koagi`
    %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_head`, {
        title: currentName,
        currentCategory: currentCategory
    }); %>
</head>
<body class="<%= currentCategory %>">
    <!-- skip navigation -->
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_skipNavigation`) %>
    <!-- // skip navigation -->

    <!-- wrap -->
    <div id="wrap">
        <!-- header -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_header`, {
            currentCategory,
            currentNav,
            currentName
        }) %>
        <!-- // header -->

        <!-- title -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_titleSub`, {
            title: '가든샵 판매 신청',
            depths: [
            CATEGORY_KO.get(state),
            '가든샵 판매 신청',
            ],
        }) %>
        <!-- // title -->

        <!-- contents -->
        <div id="body">
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_shopFinish`, {
            }) %>
        </div>
        <!-- // contents -->

        <!-- footer -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_footer`, {
            currentName,
            currentCategory,
        }) %>
        <!-- // footer -->

        <!-- navigation -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_navigation`, {
            currentCategory: currentCategory
        }) %>
        <!-- // navigation -->
    </div>
    <!-- // wrap -->
</body>
</html>