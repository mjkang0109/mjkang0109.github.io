---
group: system
state:
    default: 연간회원소개
---
<!DOCTYPE html>
<html lang="ko">
<%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_constants`, {

}) %>
<head>
    <%
    currentName = '한국수목원정원관리원';
    currentCategory = 'system';
    currentNav = 'koagi';
    imgPath = `${process.env.IMG_PATH}/koagi`;
    %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_head`, {
    title: currentName,
    currentCategory: currentCategory
    }); %>
</head>
<body class="<%= currentCategory ;%>">
    <!-- skip navigation -->
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_skipNavigation`) %>
    <!-- // skip navigation -->
    <!-- wrap -->
    <div id="wrap">
        <!-- header -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_header`, {
        currentCategory,
        currentNav,
        currentName
        }) %>
        <!-- // header -->
        <!-- title -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_titleSub`, {
        title: '연간회원 소개',
        depths: [
        '연간회원 신청',
        '연간회원 소개',
        ],
        }) %>
        <!-- // title -->
        <!-- contents -->
        <div id="body">
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_customVisual`, {
            title: `<strong>연간회원 서비스 안내</strong>`,
            desc: '자연과 가까워지는 가장 아름다운 방법, 한국수목원정원관리원 연간회원. <br>사계절 정원의 초대와 다양한 회원 전용 혜택으로 매 순간 새로운 감동을 만나보세요. ',
            button: '<div class="buttons"><a href="#" class="button-navy">개인회원 신청</a><a href="#" class="button-navy">기관회원 신청</a></div>',
            img: 'membership',
            }) %>
            
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_membershipIntro`, {
                
            }) %>

        </div>
        <!-- // contents -->
        <!-- footer -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_footer`, {
        currentName,
        currentCategory,
        }) %>
        <!-- // footer -->
        <!-- navigation -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_navigation`, {
        currentCategory: currentCategory
        }) %>
        <!-- // navigation -->
    </div>
    <!-- // wrap -->
</body>
</html>