---
group: system
state:
    default: 연간회원가입-개인
    organization: 연관회원가입-기괸
    donation: 연간회원가입-기부
---
<!DOCTYPE html>
<html lang="ko">
<%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_constants`, {

}) %>
<head>
    <%
    currentName = '한국수목원정원관리원';
    currentCategory = 'system';
    currentNav = 'koagi';
    imgPath = `${process.env.IMG_PATH}/koagi`;
    %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_head`, {
    title: currentName,
    currentCategory: currentCategory
    }); %>
</head>
<body class="<%= currentCategory ;%>">
    <!-- skip navigation -->
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_skipNavigation`) %>
    <!-- // skip navigation -->
    <!-- wrap -->
    <div id="wrap">
        <!-- header -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_header`, {
        currentCategory,
        currentNav,
        currentName
        }) %>
        <!-- // header -->
        <!-- title -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_titleSub`, {
        title: `연간회원 가입`,
        depths: [
        '한국수목원정원관리원',
        '연간회원 신청',
        '연간회원 가입',
        ],
        }) %>
        <!-- // title -->
        <!-- contents -->
        <% const index = {
            default: 0,
            organization: 1,
            donation: 2,
        }
        %>
        <div id="body">
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_tab`, {
                items: ['개인회원', '기관회원', '기부회원'],
                current: index[state]
            }) %>

            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_membershipType`, {
            }) %>
        </div>
        <!-- // contents -->
        <!-- footer -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_footer`, {
        currentName,
        currentCategory,
        }) %>
        <!-- // footer -->
        <!-- navigation -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_navigation`, {
        currentCategory: currentCategory
        }) %>
        <!-- // navigation -->
    </div>
    <!-- // wrap -->
</body>
</html>