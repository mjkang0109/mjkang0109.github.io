---
group: garden
state:
    default: 공모전소개
---
<!DOCTYPE html>
<html lang="ko">
<head>
    <%
    currentName = '국립정원문화원';
    currentCategory = 'garden';
    currentNav = 'koreaGarden';
    imgPath = `${process.env.IMG_PATH}/koagi`
    %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_head`, {
    title: currentName,
    currentCategory: currentCategory
    }); %>
</head>
<body class="<%= currentCategory %>">

    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_businessItems`, {

    }) %>
    <!-- skip navigation -->
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_skipNavigation`) %>
    <!-- // skip navigation -->

    <!-- wrap -->
    <div id="wrap">
        <!-- header -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_header`, {
        currentCategory,
        currentNav,
        currentName
        }) %>
        <!-- // header -->

        <!-- visual sub -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_visualSub`, {
        type: 'plant',
        currentNav: '코리아가든쇼',
        key: '국민이 행복한 수목원',
        info: '산림생물다양성 보전과 활용의 중심인 국립백두대간수목원에서<br>산림가치 증진을 통해 국민이 행복한 수목원을 만들어 나가겠습니다',
        }) %>
        <!-- // visual sub -->

        <!-- title -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_titleSub`, {
        title: '공모전 소개',
        depths: [
        '코리아가든쇼',
        '공모전 소개',
        ],
        }) %>
        <!-- // title -->

        <!-- contents -->
        <div id="body">
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_customVisual`, {
            title: `<strong>코리아가든쇼</strong>`,
            desc: '정원문화 대중화 및 생활 가드닝에 대한 <strong>관심 고취</strong>와 <br><strong>정원산업 발전을 도모</strong>하고 국민들에게 홍보 ',
            img: 'k-garden',
            type: 'kGarden',
            }) %>
            <section class="detail-section">
                <strong class="title-leaves">사용절차</strong>
                <ul class="intro-items">
                    <%
                    const items = [
                        {
                            desc : '전 국민의 정원문화 참여와<br>가드닝에 대한 관심 고취',
                        },
                        {
                            desc : '정원산업 발전을 위한<br>수준 높은 정원 작품 전시',
                        },
                        {
                            desc : '우수한 정원 디자이너를<br>발굴·육성하고 국민들에게 홍보',
                        },
                        {
                            desc : '국내 최고 권위 가든쇼로서<br>지역 정원박람회 활성화를 견인',
                        },
                    ];
                    %>
                    <% items.map((item, i) => { %>
                    <li>
                        <span class="img-wrap">
                            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                            width: 330,
                            height: 253,
                            isSimply: true,
                            source: `${imgPath}/kgarden-intro${i + 1}.jpg`,
                            alt: '',
                            }); %>
                        </span>
                        <div class="desc-wrap">
                            <p class="desc"><%- item.desc; %></p>
                        </div>
                    </li>
                    <% }); %>
                </ul>
            </section>
            <section class="detail-section">
                <strong class="title-leaves">행사 연혁</strong>
                <%
                const history = [
                    {
                        year: 2014,
                        title: '주제 : 도시민들의 상처받은 몸과 마음에 휴식을 주는 정원',
                        desc: '당선작가 : 17명',
                    },
                    {
                        year: 2015,
                        title: '주제 : 내 삶에 들어온 정원',
                        desc: '당선작가 : 15명',
                    },
                    {
                        year: 2016,
                        title: '주제 : 가장 한국적인 멋을 담 신한류 정원',
                        desc: '당선작가 : 10명',
                    },
                    {
                        year: 2017,
                        title: '주제 : 토닥토닥, 내 삶에 위로를 주는 정원',
                        desc: '당선작가 : 10명',
                    },
                    {
                        year: 2020,
                        title: '주제 : 사람과 자연을 이어주는 공간, 정원',
                        desc: '당선작가 : 10명',
                    },
                    {
                        year: 2021,
                        title: '주제 : 정원, 그 안에 자연을 담다',
                        desc: '당선작가 : 12명',
                    },
                    {
                        year: 2022,
                        title: '주제 : 사람과 자연을 이어주는 공간, 정원',
                        desc: '당선작가 : 10명',
                    },
                    {
                        year: 2023,
                        title: '주제 : 정원, 그 안에 자연을 담다',
                        desc: '당선작가 : 12명',
                    },
                    {
                        year: 2024,
                        title: '주제 : ‘통섭(統攝)’ 정원, 그 경계를 허물다.',
                        desc: '당선작가 : 6명',
                    },
                    {
                        year: 2025,
                        title: '주제 : 한국의 멋을 담은 정원',
                        desc: '당선작가 : 6명',
                    },
                ]
                %>
                <ul class="flag-item">
                    <% history.map(h => { %>
                    <li>
                        <strong><%= h.year %></strong>
                        <ul class="dot-caution">
                            <li><%= h.title %></li>
                            <li><%= h.desc %></li>
                        </ul>
                    </li>
                    <% }) %>
                </ul>
            </section>
        </div>
        <!-- // contents -->

        <!-- footer -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_footer`, {
        currentName,
        currentCategory,
        }) %>
        <!-- // footer -->

        <!-- navigation -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_navigation`, {
        currentCategory: currentCategory
        }) %>
        <!-- // navigation -->
    </div>
    <!-- // wrap -->
</body>
</html>