<footer>
    <%
    const items = [
        {
            logo  : 'seoul',
            name  : '서울',
            width : 107,
            height: 27,
        },
        {
            logo  : 'family',
            name  : '서울여성가족재단',
            width : 168,
            height: 45,
        },
        {
            logo  : 'gender',
            name  : '성평등가족부',
            width : 144,
            height: 49,
        },
        {
            logo  : 'korea-gender',
            name  : '한국양성평등교육진흥원',
            width : 172,
            height: 27,
        },
        {
            logo  : 'safe',
            name  : '서울디지털성범죄 안심지원센터',
            width : 121,
            height: 40,
        },
    ];
    %>
    <div class="footer-top">
        <strong>관련사이트</strong>
        <ul>
            <% items.map((item) => { %>
                <li>
                    <a href="#"
                       target="_blank"
                       rel="noopener noreferrer">
                        <span class="img-wrap">
                            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                            width: item.width,
                            height: item.height,
                            isSimply: true,
                            source: `${imgPath}/main/logo-${item.logo}.png`,
                            alt: item.name,
                            }); %>
                        </span>
                    </a>
                </li>
            <% }); %>
        </ul>
    </div>
    <div class="footer-bottom">
        <%
        const terms = [
            '개인정보처리방침',
            '이용약관',
            '이메일무단수집거부',
            '홈페이지 개선 의견',
        ];
        %>
        <ul class="terms">
            <% terms.map(term => { %>
                <li>
                    <a href="#">
                        <%= term ;%>
                    </a>
                </li>
            <% }); %>
        </ul>
        <address>(우)06939 서울특별시 동작구 여의대방로 54길 18(대방동)</address>
        <ul class="info">
            <li>사업자등록번호 : 108-82-05343</li>
            <li>전화 :
                <a href="tel:02-810-5000">02-810-5000</a>
            </li>
            <li>팩스 :
                <a href="tel:02-810-5490">02-810-5490</a>
            </li>
            <li>메일 :
                <a href="mailto:archive@seoulwomen.or.kr">archive@seoulwomen.or.kr</a>
            </li>
        </ul>
        <p class="copyright">© SEOUL FOUNDATION OF WOMEN AND FAMILY. All Rights Reserved.</p>
    </div>
</footer>