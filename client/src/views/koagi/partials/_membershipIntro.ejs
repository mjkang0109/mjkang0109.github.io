<strong class="title-line">
    연간회원 유형
</strong>
<ul class="cyan-box-items">
    <%
    const items = [
        {
            title  : '일반회원',
            benefit: 5,
            desc   : '만 7세 이상 ~ 65세 미만',
        },
        {
            title  : '지역회원',
            benefit: 5,
            desc   : '한국수목원정원관리원에서<br>운영하는 수목원/식물원이<br>위치한 지역 거주민',
        },
        {
            title  : '평생회원',
            benefit: 6,
            desc   : '평생 1회 납부하며,<br>한국수목원정원관리원의<br>모든 혜택 적용',
        },
        {
            title  : '어울림회원',
            benefit: 2,
            desc   : '만 65세 이상<br>또는 만6세 이하',
        },
        {
            title  : '기관회원',
            benefit: 3,
            desc   : '20인 이상<br>재직직원 대상 기업',
        },
    ];
    %>
    <% items.map(item => { %>
        <li>
            <strong class="type"><%= item.title; %></strong>
            <div class="desc-wrap">
                <strong class="color-pink"><%= item.benefit; %>가지 혜택!</strong>
                <p class="desc"><%- item.desc; %></p>
            </div>
        </li>
    <% }); %>
</ul>
<section class="detail-section">
