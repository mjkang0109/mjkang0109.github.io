                    <li>
                        <span class="img-wrap">
                            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                            width: items4[i].width,
                            height: items4[i].height,
                            isSimply: true,
                            source: `${imgPath}/forest2-${i + 1}.jpg`,
                            alt: '',
                            }); %>
                        </span>
                    </li>
                <% } %>
            </ul>
            <strong class="title">야생식물·종자 추출물 제조 및 대사체, 유용성 연구</strong>
        </div>
        <div class="images-wrap">
