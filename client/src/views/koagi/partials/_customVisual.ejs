<%
var title = title || '';
var desc = desc || '';
var button = button || undefined;
var img = img || '';
var type = type || false;
%>

<div class="custom-visual<%= type ? ` ${type}` : '' %>">
    <div class="left">
        <div class="title"><%- title %></div>
        <p class="desc"><%- desc %></p>
        <%- button %>
    </div>

    <div class="right">
        <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
        width: 650,
        height: 478,
        isSimply: true,
        source: `${imgPath}/dummy-${img}.jpg`,
        alt: '',
        }); %>
    </div>
</div>