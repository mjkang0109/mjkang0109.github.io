<div class="detail-section">
    <div class="map-wrap">
        <ul class="map-info">
            <li>
                <span class="icon">
                    <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                    width: 25,
                    height: 26,
                    isSimply: true,
                    source: `${imgPath}/icon-flag.png`,
                    alt: '깃발',
                    }); %>
                </span>
                <strong class="title">난이도</strong>
                <span class="score"
                      data-score="4">
                    <span class="sound-only">
                        전체 난이도 4 중에 3
                    </span>
                </span>
            </li>
            <li>
                <span class="icon">
                    <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                    width: 24,
                    height: 24,
                    isSimply: true,
                    source: `${imgPath}/icon-course.png`,
                    alt: '코스',
                    }); %>
                </span>
                <strong class="title">거리</strong>
                <strong>2.3km</strong>
            </li>
            <li>
                <span class="icon">
                    <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                    width: 26,
                    height: 25,
                    isSimply: true,
                    source: `${imgPath}/icon-clock-white.png`,
                    alt: '시계',
                    }); %>
                </span>
                <strong class="title">소요시간</strong>
                <strong>
                    <span class="large">1</span>
                    <span>시간</span>
                    <span class="large">30</span>
                    <span>분</span>
                </strong>
            </li>
        </ul>
        <span class="img-wrap">
            <picture class="img_wrap">
                <source media="all and (max-width: 1199px)"
                        srcset="<%= imgPath %>/map-m.png">
                <img src="<%= imgPath %>/map-<%= currentCategory %>.png"
                     width="1450"
                     height="728"
                     alt="">
            </picture>
        </span>
        <%
        const course = [
            '방문자센터',
            '희귀식물원',
            '특산식물원',
            '100회마라톤공원',
            '비안의언덕(야생화재배단지)',
            '동물이름식물원',
            '모듬정원',
            '숲속책장',
            '비밀의화원',
            '연구센터',
        ];
        %>
        <div class="course-detail">
            <strong>관람동선</strong>
            <ol>
                <% course.map(c => { %>
                    <li><%= c; %></li>
                <% }); %>
            </ol>
        </div>
    </div>

    <%
    const items = [
        '방문자센터',
        '진입광장',
        '어린이정원',
        '모험의 숲',
        '식물분류원',
        '약용식물원',
        'swiper',
        'swiper',
        'swiper',
        'swiper',
        'swiper',
    ];

    const length = items.length;
    %>
    <div class="swiper-scroll">
        <p>이미지를 클릭하시면 보다 상세한 정보를 확인할 수 있습니다.</p>
        <div class="swiper-wrap swiper"
             id="courseSwiper"
             data-scrollbar="true"
             data-gap="25"
             data-per-view="auto">
            <ul class="swiper-wrapper"
                role="tablist">
                <% for (let i = 0; i < length; i++) { %>
                    <li class="swiper-slide">
                        <div role="tab"
                             aria-controls="panel<%= i + 1; %>"
                             aria-selected="<%= i === 0; %>">
                        <span class="img-wrap">
                            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                            width: 650,
                            height: 488,
                            isSimply: true,
                            source: `${imgPath}/dummy-guide.jpg`,
                            alt: '',
                            }); %>
                        </span>
                            <strong>
                                <%= items[i]; %><%= i + 1; %>
                            </strong>
                        </div>
                    </li>
                <% } %>
            </ul>
            <div class="scrollbar"></div>
        </div>
    </div>

    <% for (let i = 0; i < length; i++) { %>
        <div id="panel<%= i + 1 %>"
             class="panel"
             role="tabpanel"
                <%- i !== 0 ? 'hidden' : '' %>>
            <%= items[i] %> 상세정보
        </div>
    <% } %>
</div>