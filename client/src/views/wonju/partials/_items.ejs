<section class="items">
    <strong class="title">우리동네
        <span class="color-pink">돌봄시설</span>
    </strong>
    <p class="desc">우리지역은 개개인별 연령대와 관심사에 따른 맞춤 정보도 제공한다.</p>
    <%
    const items = [
        {
            title: '다함께돌봄센터 H아이마을',
            desc : '#정기돌봄  #일시돌봄 #6세~12세 #아동돌보미',
        },
        {
            title: '가톨릭꿈나무 지역아동센터',
            desc : '#정기돌봄  #일시돌봄 #6세~12세 #아동돌보미',
        },
        {
            title: '다함께돌봄센터 H아이마을',
            desc : '#정기돌봄  #일시돌봄 #6세~12세 #아동돌보미',
        },
        {
            title: '가톨릭꿈나무 지역아동센터',
            desc : '#정기돌봄  #일시돌봄 #6세~12세 #아동돌보미',
        },
    ];
    %>
    <div class="swiper-link swiper">
        <ul class="swiper-wrapper">
            <% for (let i = 0; i < 10; i++) { %>
            <li class="swiper-slide">
                <ul class="link-items">
                    <% items.map((item, i) => { %>
                        <li>
                            <a href="#">
                                <span class="img-wrap">
                                    <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                                    width:328,
                                    height: 250,
                                    isSimply: true,
                                    source: `${imgPath}/dummy${i + 1}.jpg`,
                                    }); %>
                                </span>
                                <% if (i === 0) { %>
                                    <span class="badges">
                                        <span class="badge orange">관람시설</span>
                                        <span class="badge outline">0~18세</span>
                                    </span>
                                <% } %>
                                <% if (i === 1) { %>
                                    <span class="badges">
                                        <span class="badge cyan">체험시설</span>
                                        <span class="badge outline">전연령</span>
                                    </span>
                                <% } %>
                                <% if (i === 2) { %>
                                    <span class="badges">
                                        <span class="badge orange">관광시설</span>
                                        <span class="badge outline">전연령</span>
                                    </span>
                                <% } %>
                                <% if (i === 3) { %>
                                    <span class="badges">
                                        <span class="badge pink">의료시설</span>
                                        <span class="badge outline">전연령</span>
                                    </span>
                                <% } %>
                                <strong class="title"><%= item.title; %></strong>
                                <p class="desc"><%= item.desc; %></p>
                            </a>
                        </li>
                    <% }); %>
                    <% items.map((item, i) => { %>
                        <li>
                            <a href="#">
                                <span class="img-wrap">
                                    <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                                    width:328,
                                    height: 250,
                                    isSimply: true,
                                    source: `${imgPath}/dummy${i + 1}.jpg`,
                                    }); %>
                                </span>
                                <% if (i === 0) { %>
                                    <span class="badges">
                                        <span class="badge orange">관람시설</span>
                                        <span class="badge outline">0~18세</span>
                                    </span>
                                <% } %>
                                <% if (i === 1) { %>
                                    <span class="badges">
                                        <span class="badge cyan">체험시설</span>
                                        <span class="badge outline">전연령</span>
                                    </span>
                                <% } %>
                                <% if (i === 2) { %>
                                    <span class="badges">
                                        <span class="badge orange">관광시설</span>
                                        <span class="badge outline">전연령</span>
                                    </span>
                                <% } %>
                                <% if (i === 3) { %>
                                    <span class="badges">
                                        <span class="badge pink">의료시설</span>
                                        <span class="badge outline">전연령</span>
                                    </span>
                                <% } %>
                                <strong class="title"><%= item.title; %></strong>
                                <p class="desc"><%= item.desc; %></p>
                            </a>
                        </li>
                    <% }); %>
                </ul>
            </li>
            <% } %>
        </ul>
        <button type="button"
                class="button-prev">
            <span class="a11y">이전</span>
        </button>
        <button type="button"
                class="button-next">
            <span class="a11y">다음</span>
        </button>
    </div>
</section>
<section class="horizon-items">
    <div class="title-wrap">
        <strong class="title">아동돌봄
            <span class="color-blue">활동사진</span>
            <a href="#">
                <span class="a11y">더보기</span>
            </a>
        </strong>
        <p class="desc">우리 아이들이 어떤 돌봄을 받고있을까요?
            <span class="sub">
                아동 돌봄 관련 정보를 한곳에, 한눈에, 한번에 제공할
                <br>
                수 있는 아동 돌봄 포털시스템 구축
            </span>
        </p>
    </div>
    <div class="items-wrap">
        <ul class="link-items">
            <% for (let i = 0; i < 4; i++) { %>
                <li>
                    <a href="#">
                        <span class="img-wrap">
                            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                            width:398,
                            height: 272,
                            isSimply: true,
                            source: `${imgPath}/dummy${i + 1}.jpg`,
                            }); %>
                        </span>
                        <span class="badges">
                            <span class="badge green">다함께돌봄센터</span>
                        </span>
                        <strong class="title">동광뷰웰마을 아동활동을 소개합니다.</strong>
                        <span class="period">2025-05-26</span>
                    </a>
                </li>
            <% } %>
            <% for (let i = 0; i < 4; i++) { %>
                <li>
                    <a href="#">
                        <span class="img-wrap">
                            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                            width:398,
                            height: 272,
                            isSimply: true,
                            source: `${imgPath}/dummy${i + 1}.jpg`,
                            }); %>
                        </span>
                        <span class="badges">
                            <span class="badge green">다함께돌봄센터</span>
                        </span>
                        <strong class="title">동광뷰웰마을 아동활동을 소개합니다.</strong>
                        <span class="period">2025-05-26</span>
                    </a>
                </li>
            <% } %>
        </ul>
    </div>
</section>