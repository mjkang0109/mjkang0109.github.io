<section class="detail-section">
    <strong class="title-leaf">온라인 신청 절차</strong>
    <div class="box outline-round-division">
        <ol class="step-items">
            <%
            const join = [
                {
                    icon  : 'ticket-hand',
                    width : 50,
                    height: 50,
                    title : '회원 또는 비회원<br>로그인',
                },
                {
                    icon  : 'payment-hand',
                    width : 49,
                    height: 43,
                    title : '연간회원 유형<br>선택 후 신청',
                },
                {
                    icon  : 'plant',
                    width : 40,
                    height: 46,
                    title : '신청서 작성 및<br>발급유형 선택',
                },
                {
                    icon  : 'bench',
                    width : 36,
                    height: 46,
                    title : '가입비<br>결제',
                },
                {
                    icon  : 'book',
                    width : 45,
                    height: 40,
                    title : '연간회원<br>가입완료',
                },
            ];
            %>
            <% join.map((j, i) => { %>
                <li>
                <span class="icon-wrap">
                     <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                     width: j.width,
                     height: j.height,
                     isSimply: true,
                     source: `${imgPath}/icon-membership${i + 1}.png`,
                     alt: '',
                     }); %>
                </span>
                    <strong class="title"><%- j.title; %></strong>
                    <% if (j.desc) { %>
                        <p><%- j.desc; %></p>
                    <% } %>
                </li>
            <% }); %>
        </ol>
        <div class="bottom">
            <span class="icon-wrap">
                 <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                 width: 28,
                 height: 31,
                 isSimply: true,
                 source: `${imgPath}/icon-caution.png`,
                 alt: '',
                 }); %>
            </span>
            <strong class="title">유의사항</strong>
            <p class="desc">실물카드 선택 시 카드를 우편으로 발송해드리지 않습니다. 가까운 소속기관 수목원에 방문하셔서 수령해주시기 바랍니다.</p>
        </div>
    </div>
</section>
