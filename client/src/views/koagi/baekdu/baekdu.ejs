---
group: baekdu
state:
    default: 메인
    emergency: 메인-긴급팝업
    popup: 메인-팝업존
---
<!DOCTYPE html>
<html lang="ko">
<head>
    <%
    currentName = '국립백두대간수목원';
    currentCategory = 'baekdu';
    currentNav = '';
    imgPath = `${process.env.IMG_PATH}/koagi`
    %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_head`, {
    title: currentName,
    currentCategory: currentCategory
    }); %>
</head>
<body class="<%= currentCategory %>">
    <!-- skip navigation -->
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_skipNavigation`) %>
    <!-- // skip navigation -->

    <!-- wrap -->
    <div id="wrap">
        <% if (state === 'emergency') { %>
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_emergency`, {
                
            }) %>
        <% } %>
        <!-- header -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_header`, {
        currentCategory,
        currentNav,
        currentName
        }) %>
        <!-- // header -->

        <!-- contents -->
        <div id="body" class="main">
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_main`, {
                
            }) %>
        </div>
        <!-- // contents -->

        <!-- footer -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_footer`, {
        currentName,
        currentCategory,
        }) %>
        <!-- // footer -->
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_layers`, {
    }) %>
    </div>
    <!-- // wrap -->
</body>
</html>