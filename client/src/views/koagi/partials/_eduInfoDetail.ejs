            {
                age  : '<strong>초등</strong><p>만6세 이상 ~ 만 4세 미만</p>',
                price: '2,000원',
                part : '10,000원',
                count: true,
                total: '',
            },
            {
                age  : '<strong>유아</strong><p>만6세 미만</p>',
                price: '2,000원',
                part : '10,000원',
                count: true,
                total: '',
            },
        ];
        %>
        <ul class="table-info">
            <li>
                <% titles.map(title => { %>
                    <div><%= title; %></div>
                <% }); %>
            </li>
            <% priceItems.map((item, i) => { %>
                <li>
                    <div>
                        <%- item.age; %>
                    </div>
                    <div>
                        <span>참가비</span>
                        <strong><%= item.price; %></strong>
                    </div>
                    <div>
                        <span>재료비</span>
                        <strong><%= item.part; %></strong>
                    </div>
                    <div class="count">
                        <button type="button"
                                class="button-increase">
                            <span class="sound-only">인원 증가</span>
                        </button>
                        <span id="jsCount<%= i + 1; %>">1</span>
                        <button type="button"
                                class="button-decrease">
                            <span class="sound-only">인원 감소</span>
                        </button>
                    </div>
                    <div>
                        <strong class="jsTotal<%= i + 1 %>">1,000원</strong>
                    </div>
                </li>
            <% }); %>
