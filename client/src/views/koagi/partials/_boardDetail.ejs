<%
var state = state || '식물관리법';
var title = title || '2025년 하반기 이동형 반려식물 클리닉 수요조사 안내';
var info = info || [['진행기간', '2025-03-01 ~ 2025-04-28']];
var content = content || 'clinic';
%>
<div class="board-detail">
    <div class="states">
        <span class="state green"><%= state; %></span>
    </div>
    <strong><%= title; %></strong>
    <ul class="info">
        <% for(let i = 0; i < info.length; i++) { %>
            <li>
                <strong><%= info[i][0]; %></strong>
                <span><%= info[i][1]; %></span>
            </li>
        <% } %>
    </ul>
    <div class="text-wrap<%= content === 'fair' ? ' border-none' : '' %>">
        <% if (content === 'clinic') { %>
            <span class="img-wrap">
            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
            width: 960,
            height: 1340,
            isSimply: true,
            source: `${imgPath}/dummy-poster-companion.png`,
            alt: '이동형 반려식물 클리닉 안내',
            }); %>
            </span>
            <div class="buttons">
                <a href="#"
                   class="button-green">온라인 신청하기
                </a>
                <a href="#"
                   class="button-green-outline">신청내역 보기
                </a>
            </div>
        <% } %>

        <% if (content === 'fair') { %>
            <%
                const boxItems = [
                    ['출품자', '아무개'],
                    ['지역', '서울'],
                    ['연락처', '010-0000-0000'],
                    ['출품식물', '식물 이름'],
                ];
            %>
            <div class="box green">
                <ul class="box-title-info">
                    <% for(let i = 0; i < boxItems.length; i++) { %>
                        <li>
                            <strong><%= boxItems[i][0] %></strong>
                            <span><%= boxItems[i][1] %></span>
                        </li>
                    <% } %>
                </ul>
            </div>
            <div class="detail-section">
                <strong>국내육성품종</strong>
                <table class="table-gray">
                    <colgroup>
                        <col style="width:234px">
                        <col style="width: 347px">
                        <col style="width: auto">
                    </colgroup>
                    <thead>
                    <tr>
                        <th>국명</th>
                        <th>품종명</th>
                        <th>학명</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>일월비비추</td>
                        <td>퍼스트벨</td>
                        <td>Pseudolysimachion longifolium (L.) Opiz</td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="detail-section">
                <strong>자생식물</strong>
                <table class="table-gray">
                    <colgroup>
                        <col style="width: 357px">
                        <col style="width: auto">
                    </colgroup>
                    <thead>
                    <tr>
                        <th>국명</th>
                        <th>학명</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>일월비비추</td>
                        <td>Pseudolysimachion longifolium (L.) Opiz</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
    <button type="button"
            class="button-navy">
        목록
    </button>
</div>