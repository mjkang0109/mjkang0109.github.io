<div class="detail-section">
    <div class="map-wrap">
        <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
        width: 1450,
        height: 896,
        isSimply: true,
        source: `${imgPath}/map-${currentCategory}.png`,
        alt: '지도',
        }); %>
        <div class="markers">
            <% new Array(11).fill('').map((item, i) => { %>
                <span <%= i === 0 ? '' : 'hidden'; %>
                    id="marker<%= i + 1; %>"
                    class="marker"
                    style="top: 0; left: 0;">
                    <span class="sound-only">위치 이름</span>
                </span>
            <% }); %>
        </div>
    </div>
    <strong class="title-leaves">
        진입 및 커뮤니티
        <span class="caution gray">이미지를 클릭하시면 보다 상세한 정보를 확인할 수 있습니다.</span>
    </strong>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_guideSwiper`, {
    }) %>
</div>