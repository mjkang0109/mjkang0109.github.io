<!--
* visual image tone 대응
- 배경 이미지 색에 따른 `.quick-nav` 영역 문구 색상 변경 필요
ㄴ `#jsTheme` tag 내 `data-theme` 추가
    ㄴ `dark` || `light`;
ㄴ `#fullSwiper .swiper-slide` tag 내 `data-theme` 추가
    ㄴ `dark` || `light`;
-->
<section id="jsTheme"
         class="top-visual"
         data-theme="light">
    <div id="fullSwiper"
         class="full-swiper swiper"
         data-loop="true"
         data-change="fade"
         data-theme="true"
         data-autoplay="5000"
         data-theme-target="jsTheme"
         data-per-view="1">
        <ul class="swiper-wrapper">
            <% for (let i = 0; i < 3; i++) { %>
                <li class="swiper-slide"
                    data-theme="<%= i === 0 ? 'light' : 'dark'; %>">
                    <picture class="img-wrap">
                        <source media="all and (max-width: 1199px)"
                                srcset="<%= imgPath; %>/visual-main-top-m.png">
                        <img src="<%= imgPath; %>/visual-main-top.png"
                             width="2000"
                             height="1050"
                             alt="">
                    </picture>
                </li>
            <% } %>
        </ul>
        <button type="button"
                class="button-prev">
            <span class="sound-only">이전</span>
        </button>
        <button type="button"
                class="button-next">
            <span class="sound-only">다음</span>
        </button>
    </div>
    <div class="wrap1500">
        <div class="quick-nav">
            <strong class="title"><%= currentName; %></strong>
            <p class="desc">도심 속에서 사계절 정원을 즐길 수 있는 대한민국 대표 도심형 스마트 수목원</p>
        </div>
        <ul class="items">
            <%
            const quick = [
                {
                    title : '이용안내',
                    width : 32,
                    height: 32,
                },
                {
                    title : '종합안내도',
                    width : 32,
                    height: 32,
                },
                {
                    title : '시설안내',
                    width : 34,
                    height: 31,
                },
                {
                    title : '공간탐방',
                    width : 32,
                    height: 32,
                },
                {
                    title : '찾아오시는길',
                    width : 28,
                    height: 35,
                },
            ];
            %>
            <%
            quick.map((q, i) => {
            %>
                <li>
                    <a href="#">
                        <span class="icon-wrap">
                            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                            width: q.width,
                            height: q.height,
                            isSimply: true,
                            source: `${imgPath}/icon-top${i + 1}.png`,
                            alt: '',
                            }); %>
                        </span>
                        <strong class="title"><%= q.title; %></strong>
                    </a>
                </li>
            <% }); %>
        </ul>
        <div id="topSwiper"
             class="top-swiper swiper"
             data-per-view="1">
            <ul class="swiper-wrapper">
                <% for (let i = 0; i < 3; i++) { %>
                    <li class="swiper-slide">
                        <a href="#">
                            <span class="img-wrap">
                                <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                                width: 592,
                                height: 358,
                                isSimply: true,
                                source: `${imgPath}/dummy-top-swiper.png`,
                                alt: '배너 이미지 설명',
                                }); %>
                            </span>
                        </a>
                    </li>
                <% } %>
            </ul>
            <div class="pagination"></div>
        </div>
    </div>
</section>
<section class="today-info">
    <div class="wrap1500">
        <div class="hour">
            <span class="icon-wrap">
                <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                width: 32,
                height: 30,
                isSimply: true,
                source: `${imgPath}/icon-clock3.png`,
                alt: '',
                }); %>
            </span>
            <div class="time-wrap">
                <strong class="title">관람시간은?</strong>
                <strong class="time">
                    09:00~18:00
                    <span class="desc">(입장마감 17:00)</span>
                </strong>
            </div>
        </div>
        <div class="weather">
            <!--
            * 날씨별 class 변경
            ㄴ 19개 날씨
            ㄴ `.icon-wrap` tag 내 `weather${index}` class 추가
            -->
            <span class="icon-wrap weather1">
            </span>
            <div class="weather-wrap">
                <strong class="title">오늘의 날씨는?</strong>
                <strong class="degree">
                    22.5&deg;
                    <span class="desc">
                        10.5&deg; / 22.5&deg;
                        <br>
                        구름조금
                    </span>
                </strong>
            </div>
        </div>
        <div class="closed">
            <strong class="title">휴관일은?</strong>
            <div id="holidaySwiper"
                 class="swiper swiper-holiday"
                 data-per-view="1">
                <ul class="swiper-wrapper closed-time">
                    <li class="swiper-slide">
                        <%
                        const closed = [
                            {
                                title: '정기',
                                date : '8월 4일 (월요일)',
                            },
                            {
                                title: '정기',
                                date : '8월 11일 (월요일)',
                            },
                            {
                                title: '임시',
                                date : '8월 11일 (월요일)',
                            },
                            {
                                title: '임시',
                                date : '12월 11일 (월요일)',
                            },
                        ];
                        %>
                        <% closed.map(c => { %>
                            <div class="holiday-wrap">
                                <strong class="title"><%= c.title; %></strong>
                                <span class="desc"><%= c.date; %></span>
                            </div>
                        <% }); %>
                    </li>
                    <li class="swiper-slide">
                        <% closed.map(c => { %>
                            <div class="holiday-wrap">
                                <strong class="title"><%= c.title; %></strong>
                                <span class="desc"><%= c.date; %></span>
                            </div>
                        <% }); %>
                    </li>
                </ul>
            </div>
            <button type="button"
                    class="button-next">
                <span class="sound-only">다음</span>
            </button>
            <button type="button"
                    class="button-prev">
                <span class="sound-only">이전</span>
            </button>
        </div>
        <a href="#"
           class="button-blue">
            <span class="icon-wrap">
                <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                width: 23,
                height: 23,
                isSimply: true,
                source: `${imgPath}/icon-search2.png`,
                alt: '',
                }); %>
            </span>
            온라인예약
        </a>
    </div>
</section>
<% if (currentCategory === 'baekdu') { %>
    <section class="attendance-tiger">
        <div class="left">
            <strong class="title">
                <span class="sub">우리 수목원 마스코트~</span>
                오늘 만나는
                <span class="color-cyan">호랑이</span>
            </strong>
        </div>
        <div class="right">
            <div id="tigerSwiper"
                 class="swiper swiper-tiger" data-per-view="auto" data-gap="0">
                <ul class="swiper-wrapper">
                    <!--
                    * 휴무일
                    ㄴ `.swiper-slide` tag 내 `closed` class 추가
                    -->
                    <% for (let i = 0; i < 6; i++) { %>
                        <li class="swiper-slide<%= i === 2 || i === 4 ? ' closed' : '' %>">
                            <span class="img-wrap">
                                <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                                width: 117,
                                height: 117,
                                isSimply: true,
                                source: `${imgPath}/profile-tiger${i + 1}.png`,
                                alt: '',
                                }); %>
                            </span>
                            <div class="text-wrap">
                                <strong class="title">이름</strong>
                                <span class="time-wrap">
                                    <strong class="title">관람시간</strong>
                                    <span class="time">09:00 ~ 13:00</span>
                                </span>
                                <span class="state"><%= i === 2 || i === 4 ? '휴무' : '출근' %></span>
                            </div>
                        </li>
                    <% } %>
                </ul>
                <button type="button"
                        class="button-prev">
                    <span class="sound-only">이전</span>
                </button>
                <button type="button"
                        class="button-next">
                    <span class="sound-only">다음</span>
                </button>
            </div>
        </div>
    </section>
<% } %>
