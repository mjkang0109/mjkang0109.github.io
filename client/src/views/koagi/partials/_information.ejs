<section class="cyan-division">
    <%
    const items = [
        {
            title : '관람시간',
            width : 56,
            height: 61,
            img   : 'clock2',
        },
        {
            title : '휴관일',
            width : 59,
            height: 62,
            img   : 'calendar3',
        },
    ];
    %>
    <% items.map((item, i) => { %>
        <div class="<%= i === 0 ? 'left' : 'right'; %>">
            <div class="cyan">
                <span class="icon-wrap">
                    <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                    width: item.width,
                    height: item.height,
                    isSimply: true,
                    source: `${imgPath}/icon-${item.img}.png`,
                    alt: '',
                    }); %>
                </span>
                <strong class="title"><%= item.title; %></strong>
            </div>
            <div class="text">
                <% if (i === 0) { %>
                    <strong class="title">
                        하절기(3~10월)
                    </strong>
                    <p class="desc">
                        화~일요일 09:00~18:00 (입장마감 17:00)
                    </p>
                    <strong class="title">
                        동절기(11~2월)
                    </strong>
                    <p class="desc">
                        화~일요일 09:00~17:00 (입장마감 16:00)
                    </p>
                <% } %>
                <% if (i === 1) { %>
                    <strong class="title">
                        월요일, 1월 1일, 설/추석 당일, 보수 기간
                    </strong>
                    <p class="desc">
                        (월요일이 공휴일인 경우 그 다음날 휴관)
                    </p>
                <% } %>
            </div>
        </div>
    <% }); %>
</section>
<section class="detail-section">
    <strong class="title-leaves">예매 및 입장방법</strong>
    <div class="box-division">
        <div class="cell">
            <strong class="title">현장 예매</strong>
            <p class="desc">방문자센터 매표소, 무인 키오스크</p>
            <span class="subDesc">※ 무료, 할인 대상자는 증빙서류를 지참하여 매표소에서 예매</span>
        </div>
        <div class="cell">
            <strong class="title">온라인 예매</strong>
            <div class="buttons">
                <a href="#"
                   class="button-navy tiny">개인 이용객 예매
                </a>
                <a href="#"
                   class="button-navy tiny">단체 이용객 예매
                </a>
            </div>
            <span class="subDesc">※ 온라인 예매 시 현장에서 모바일 티켓으로 바로 입장</span>
        </div>
    </div>
</section>
<section class="detail-section">
    <strong class="title-leaves">요금안내</strong>
    <div class="table-grid grid5">
        <%
        const tableHead = ['대상', '개인', '단체 (20인 이상)', '할인', '무료'];
        const type = [
            '<strong>어른</strong><span>(만 19세 이상)</span>',
            '<strong>청소년</strong><span>(만13세 이상~만 18세 이하)</span>',
            '<strong>어린이</strong><span>(만7세 이상~만 12세 이하)</span>',
        ];
        const price = [
            '5,000원',
            '4,000원',
            '3,000원',
        ];

        const price2 = [
            '4,000원',
            '3,000원',
            '2,000원',
        ];
        %>
        <% tableHead.map((head, i)=> { %>
            <div class="head<%= i === tableHead.length - 1 ? ' border-right-none' : '' %>">
                <strong><%= head %></strong>
            </div>
        <% }); %>

        <div><%- type[0] %></div>
        <div><%- price[0] %></div>
        <div><%- price2[0] %></div>
        <div class="row2-5 col4">
            지역주민 및
            <br>
            할인대상 기준 참고
            <br>
            <a href="#"
               class="button-navy tiny">할인대상 보기
            </a>
        </div>
        <div class="row2-5 col5 border-right-none">
            연간회원 및
            <br>
            무료대상자 기준 참고
            <br>
            <a href="#"
               class="button-navy tiny">무료대상 보기
            </a>
        </div>
        <div><%- type[1] %></div>
        <div class=""><%- price[1] %></div>
        <div class=""><%- price2[1] %></div>
        <div><%- type[2] %></div>
        <div><%- price[2] %></div>
        <div><%- price2[2] %></div>
    </div>
    <ul class="dot-caution">
        <li>입장권은 당일에 한하여 유효</li>
        <li>단체는 입장권 1장으로 발급</li>
        <li>단체 인솔자 무료 [단, 교사자격증(보육교사자격증, 재직증명서 등) 지참한 경우에 한함]</li>
        <li>일부 무료/할인 입장권은 유인 매표소에서 발권 가능</li>
        <li>할인·무료대상자는 신분증 등 증명자료가 필요하며, 미지참시 정상입장료 발생</li>
    </ul>
</section>
<section class="detail-section">
    <strong class="title-leaves">
        연간회원 혜택
    </strong>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_benefit`, {
    }) %>
</section>
<section class="detail-section">
    <strong class="title-leaves">
        방문안내
    </strong>
    <div class="box-division">
        <% const items2 = [
            '시설안내', '오시는 길', '종합안내도',
        ]
        %>
        <% items2.map(item2 => { %>
            <div class="cell">
