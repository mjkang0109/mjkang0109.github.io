        </div>
        <ul class="tree-wrap tree3">
            <%
                const items2 = [
                    {
                        title   : '식물 마이크로바이옴',
                        subItems: [
                            '근권 및 내생균 마이크로바이옴 분석',
                            '마이크로바이옴 기능 분석',
                            '유용 유전자 발굴',
                        ],
                    },
                    {
                        title   : '산림환경 마이크로바이옴',
                        subItems: [
                            '환경 마이크로바이옴 분석',
                            '마이크로바이옴 기능 분석',
                            '유용 유전자 발굴',
                        ],
                    },
                    {
                        title   : '산림마이크로바이옴DB',
                        subItems: [
                            '산림마이크로바이옴 동정',
                            '기능, 특성 정보',
                            '유용 미생물 및 유전자 정보',
                        ],
                    },
                ];
            %>
            <li class="tree-parent">
                <strong class="title">산림마이크로바이옴 연구기반 구축</strong>
            </li>
            <% items2.map(item => { %>
                <li class="grid-child cyan-box">
                    <strong class="title">
                        <%= item.title; %>
                    </strong>

                    <% if (item.subItems) { %>
                        <ul class="items">
                            <% item.subItems.map(sub => { %>
                                <li>&middot; <%= sub %></li>
                            <% }); %>
                        </ul>
                    <% } %>
                </li>
            <% }); %>
        </ul>
        <div class="box-darkgreen">
            <strong class="title">수요 맞춤형 산업화 소재·기술 개발 및 산·학계 지원</strong>
            <ul class="items">
                <%
                    const items6 = [
                        '산·학계 지원을 위한 산림생물자원 통합 자원은행 구축 및 운영',
                        '자원별 표준품질 관리 매뉴얼 개발로 신뢰성 확보',
                        '그린바이오 기업체 표준화 원료 공급',
                    ]
