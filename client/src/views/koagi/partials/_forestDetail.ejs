        </div>
        <span class="img-wrap">
            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
            width: 1200,
            height: 610,
            isSimply: true,
            source: `${imgPath}/forest2-7.jpg`,
            alt: '',
            }); %>
        </span>
        <div class="img-box">
            <span class="img-wrap">
                <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
                width: 806,
                height: 333,
                isSimply: true,
                source: `${imgPath}/forest2-8.jpg`,
                alt: '',
                }); %>
            </span>
            <strong class="title">지역상생을 위한 지역 기업 지원</strong>
        </div>
        <div class="img-box">
            <span class="img-wrap">
                <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
