<ol class="info-step">
    <li class="current info">신청정보</li>
    <li class="payment">결제</li>
    <li class="finish">신청완료</li>
</ol>
<section class="detail-info">
    <article class="detail-section">
        <strong class="detail-title">한여름밤의 초대 꽃마숲 가든스테이</strong>
        <p class="detail-desc">
            <strong>유의사항</strong>
            <span>예약 신청 후, 알림톡이 오지않는다면 <strong>[마이페이지 > 나의 신청내역]</strong>에서 신청완료 여부를 확인하시길 바랍니다.</span>
        </p>
    </article>
    <article class="detail-section">
        <strong>이용일 선택</strong>
        <div class="box green division">
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_calendar`, {
            }) %>
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_schedule`, {
            buttonText: '선택'
            }) %>
        </div>
    </article>
    <%
    const basicInfo = [
        ['제공기관', '국립백두대간수목원'],
        ['프로그램명', '[개인]백두대간 숲싹 실험실 (선착마감)'],
        ['이름', '김청수', '생년월일', ['input', '1990-01-01']],
        ['연락처', '010-0000-0000', '이메일', ['input', 'sample123@korea.com']],
        ['거주지역', ['select', '시·도 선택']],
        ['유입경로', ['checkbox', ['인터넷 검색', '소셜미디어', '지인 추천', '재방문', '기타']]],
    ];
    const parkingInfo = [
        ['차량이용', ['radio', ['이용', '미이용']]],
        ['차량번호', ['input', '123가9999 (띄어쓰기 없이 입력하세요.)'], '<strong class="caution">※ 차량 이용 시 주차등록을 위한 정보 입력이 필요합니다.</strong>'],
        ['차량번호', ['input', '123가9999 (띄어쓰기 없이 입력하세요.)']],
    ];
    %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_tableForm`, {
    category: 'basic',
    title: '기본정보',
    items: basicInfo,
    }) %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_tableForm`, {
    category: 'parking',
    title: '주차정보',
    items: parkingInfo,
    }) %>
    <article class="detail-section">
        <strong>파일첨부</strong>
        <table class="table-horizon">
            <tbody>
            <tr>
                <th>파일첨부</th>
                <td>
                    <ul class="box outline">
                        <li>
                            <button type="button"
                                    class="button-delete">
                                <span class="sound-only">삭제</span>
                            </button>
                            <span>한국수목원정원관리원_sample_file.xlsx (13 KB)</span>
                        </li>
                        <li>
                            <button type="button"
                                    class="button-delete">
                                <span class="sound-only">삭제</span>
                            </button>
                            <span>한국수목원정원관리원_sample_file.xlsx (13 KB)</span>
                        </li>
                        <li>
                            <button type="button"
                                    class="button-delete">
                                <span class="sound-only">삭제</span>
                            </button>
                            <span>한국수목원정원관리원_sample_file.xlsx (13 KB)</span>
                        </li>
                    </ul>
                    <div class="buttons">
                        <button type="button"
                                class="button-navy">
                            파일선택
                        </button>
                        <button type="button"
                                class="button-navy">
                            모두삭제
                        </button>
                    </div>
                    <p class="caution">
                        ※ 첨부파일 제한용량 : 50 MB
                        <br>※ 허용파일 유형 : gif, jpg, png, jpeg
                    </p>
                </td>
            </tr>
            </tbody>
        </table>
