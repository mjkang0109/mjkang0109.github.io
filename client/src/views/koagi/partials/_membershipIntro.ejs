            '행사, 전시<br>정보 제공',
            '회원의 날<br>행사 초청',
            '가든샵, 카페<br>10% 할인',
            '교육, 해설 등<br>교육비 할인',
            '교육 연수동<br>50% 할인',
        ];
        const type = [
            '개인회원',
            '기업회원',
            '기부회원',
        ];

        const type2 = [
            '일반회원',
            '지역회원',
            '평생회원',
            '어울림회원',
            '기관회원',
            '기부회원',
            '기관회원',
            '기부회원',
        ];

        const percent = [
            '20%',
            '20%',
            '50%',
            '',
            '',
            '50%',
        ];

        const percent2 = [
            '',
            '',
            '50%',
            '',
            '',
            '50%',
        ];
        %>
        <% tableHead.map((head, i)=> { %>
            <div class="head<%= i === 0 ? ' col1-3' : ''; %><%= i === tableHead.length - 1 ? ' border-right-none' : ''; %>">
                <strong><%- head; %></strong>
            </div>
        <% }); %>

        <div class="row2-6"><%= type[0]; %></div>
        <div><%= type2[0]; %></div>
        <div class="row2-8 col3">공통 적용</div>
        <div class="row2-8 col4">공통 적용</div>
        <div>○</div>
        <div>○</div>
        <div><%= percent[0]; %></div>
        <div class="border-right-none"><%= percent2[0]; %></div>
        <div><%= type2[1]; %></div>
        <div>○</div>
        <div>○</div>
        <div><%= percent[1]; %></div>
        <div class="border-right-none"><%= percent2[1]; %></div>
        <div><%= type2[2]; %></div>
        <div>○</div>
        <div>○</div>
        <div><%= percent[2]; %></div>
        <div class="border-right-none"><%= percent2[2]; %></div>
        <div><%= type2[3]; %></div>
        <div></div>
        <div></div>
        <div><%= percent[3]; %></div>
        <div class="border-right-none"><%= percent2[3]; %></div>
        <div><%= type[1]; %></div>
        <div><%= type2[4]; %></div>
        <div></div>
        <div>○</div>
        <div><%= percent[4]; %></div>
        <div class="border-right-none"><%= percent2[4]; %></div>
        <div><%= type[2]; %></div>
