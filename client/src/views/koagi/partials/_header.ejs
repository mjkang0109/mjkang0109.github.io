<%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_sitemap`, {
}) %>
<%
var currentNav = currentNav || '';
var currentName = currentName || '국립백두대간수목원';
var currentCategory = currentCategory || 'baekdu';

randomNumber = (min, max) => {
    const minNum = min ?? 0;
    const maxNum = max ?? 1000;
    return Math.floor(Math.random() * (maxNum - minNum + 1) + minNum);
};
%>
<div id="header"
     class="<%= currentCategory === 'system' ? 'system' : ''; %>">
    <!-- uh -->
    <div class="uh">
        <div class="bg">
            <div class="link">
                <a href="./../<%= currentCategory %>/<%= currentCategory %>.html"
                   class="type2"><%= currentName; %>
                </a>
                <% if (currentCategory === 'system') { %>
                    <a href="#">한국수목원정원관리원</a>
                <% } %>
                <%
                const length = navItems.length;
                for (let h = 0; h < length; h++) {
                    if (navItems[h].name === currentCategory || navItems[h].name === 'system' || navItems[h].name === 'bgsv') {
                        continue;
                    }
                %>
                <a href="./../<%= navItems[h].name %>/<%= navItems[h].name %>.html"><%= navItems[h].title; %></a>
                <%
                }
                %>
            </div>
            <div class="util">
                <a href="./login.html">로그인</a>
                <a href="./join.html">회원가입</a>
                <a href="./cs.html">고객지원</a>
            </div>
        </div>
    </div>
    <!-- //uh -->
    <!-- mh -->
    <div class="mh">
        <div class="bg">
            <h1>
                <a href="./<%= currentCategory %>.html">
                    <span class="forW">
                        <img src="<%= process.env.IMG_PATH; %>/koagi/logo-<%= currentCategory === 'system' ? 'koagi' : currentCategory; %>.png"
                             alt="<%= currentName; %>">
                    </span>
                    <span class="forM">
                        <img src="<%= process.env.IMG_PATH; %>/koagi/logo-<%= currentCategory === 'system' ? 'koagi' : currentCategory; %>-m.png"
                             alt="<%= currentName; %>">
                    </span>
                </a>
            </h1>
            <!-- gnb -->
            <div id="gnb"
                 class="mGnb">
                <h2 class="sound-only">메인 메뉴</h2>
                <ul class="list">
                    <%
                    const currentIndex = nav[currentCategory];
                    const currentItems = navItems[currentIndex].items;
                    const currentLength = currentItems.length;
                    for (let i = 0; i < currentLength; i++) {
                        if (currentItems[i].title === '메인' || currentItems[i].title.includes(':')) {
                            continue;
                        }
                    %>
                    <li class="m1<%= currentNav === currentItems[i].name ? ' active' : ''; %>">
                        <a href="<%= currentItems[i].name === '#' ? '#' : `./${currentItems[i].name}.html` %>"
                           class="dep1"><%= currentItems[i].title; %>
                        </a>
                        <%
                            const currentPages = currentItems[i].pages;
                        if (currentPages) {
                            const pageLength = currentPages.length;
                        %>
                        <div class="dep2">
                            <div class="ti">
                                <strong class="t"><%= currentItems[i].title; %></strong>
                                <p class="c">Korea Arboreta and Gardens Institute</p>
                            </div>
                            <div class="ls">
                                <ul>
                                    <%
                                    for (let j = 0; j < pageLength; j++) {
                                        if (currentPages[j].title.includes(':')) {
                                            continue;
                                        }
                                    %>
                                    <li>
                                        <a href="<%= currentPages[j].name === '#' ? '#' : `./${currentPages[j].name}.html` %>"
                                           class="t"><%= currentPages[j].title; %>
                                        </a>
                                        <%
                                            const currentSubItems = currentPages[j].subItems;
                                        if (currentSubItems) {
                                            const subItemsLength = currentPages[j].subItems.length;
                                        for (let k = 0; k < subItemsLength; k++) {
                                            if (currentSubItems[k].title.includes(':')) {
                                                continue;
                                            }
                                        %>
                                        <div class="dep3">
                                            <a href="./<%= currentSubItems[k].name %>.html"><%= currentSubItems[k].title; %></a>
                                        </div>
                                        <% }
                                        } %>
                                    </li>
                                    <%
                                    }
                                    %>
                                </ul>
                            </div>
                        </div>
                        <%
                        }
                        %>
                    </li>
                    <% } %>
                </ul>
            </div>
            <!-- //gnb -->
            <div class="util">
                <!-- forWeb -->
                <span class="forW">
                    <a href="#"
                       class="iFind1">검색
                    </a>
                </span>
                <a href="#jsSitemap1"
                   class="iMenu1 jsBtnMenu1">전체메뉴
                </a>
                <a href="#"
                   class="iLog1 forM">로그인
                </a>
            </div>
        </div>
    </div>
    <!-- //mh -->
    <div id="jsSitemap1"
         class="sitemap">
        <div class="wrap1500">
            <ul class="main-items">
                <%
                for (let i = 0; i < currentLength; i++) {
                    if (currentItems[i].title === '메인' || currentItems[i].title.includes(':')) {
                        continue;
                    }
                %>
                <li class="main-item<%= currentNav === currentItems[i].name ? ' active' : ''; %>">
                    <a href="<%= currentItems[i].name === '#' ? '#' : `./${currentItems[i].name}.html` %>">
                        <%= currentItems[i].title; %>
                    </a>
                    <%
                        const currentPages = currentItems[i].pages;
                    if (currentPages) {
                        const pageLength = currentPages.length;
                    %>
                    <ul class="sub-items">
                        <%
                        for (let j = 0; j < pageLength; j++) {
                            if (currentPages[j].title.includes(':')) {
                                continue;
                            }
                        %>
                        <li class="sub-item">
                            <a href="<%= currentPages[j].name === '#' ? '#' : `./${currentPages[j].name}.html` %>"
                               class="t"><%= currentPages[j].title; %>
                            </a>
                            <%
                                const currentSubItems = currentPages[j].subItems;
                            if (currentSubItems) {
                                const subItemsLength = currentPages[j].subItems.length;
                                const filterItems = currentPages[j].subItems.filter(a => !a.title.includes(":"));
                                const filterItemsLength = filterItems.length;
                            if (filterItemsLength > 0) {
                            %>
                                <ul class="items">
                                    <%
                                    for (let k = 0; k < subItemsLength; k++) {
                                        if (currentSubItems[k].title.includes(':')) {
                                            continue;
                                        }
                                    %>
                                    <li class="item">
                                        <a href="./<%= currentSubItems[k].name %>.html">
                                            &middot; <%= currentSubItems[k].title; %></a>
                                    </li>
                                    <% }
                                    %>
                                </ul>
                            <%
                            }
                            }
                            %>
                        </li>
                        <%
                        }
                        %>
                    </ul>
                    <%
                    }
                    %>
                </li>
                <% } %>
            </ul>
            <button type="button"
                    class="button-close"
            onclick="document.getElementById('jsSitemap1').classList.remove('active')">
                <span class="sound-only">닫기</span>
            </button>
        </div>
    </div>
</div>
