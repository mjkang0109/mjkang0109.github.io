<%
var state = state || '식물관리법';
var title = title || '2025년 하반기 이동형 반려식물 클리닉 수요조사 안내';
var info = info || [['진행기간', '2025-03-01 ~ 2025-04-28']];
var content = content || 'clinic';
%>
<div class="board-detail">
    <div class="states">
        <span class="state green"><%= state; %></span>
    </div>
    <strong><%= title; %></strong>
    <ul class="info">
        <% for(let i = 0; i < info.length; i++) { %>
            <li>
                <strong><%= info[i][0]; %></strong>
                <span><%= info[i][1]; %></span>
            </li>
        <% } %>
    </ul>
    <%
    const borderNone = ['fair', 'qna'].some(a => a === content);
    %>
    <div class="text-wrap<%= borderNone ? ' border-none' : '' %>">
        <% if (content === 'clinic') { %>
            <span class="img-wrap">
            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
            width: 960,
            height: 1340,
            isSimply: true,
            source: `${imgPath}/dummy-poster-companion.png`,
            alt: '이동형 반려식물 클리닉 안내',
            }); %>
            </span>
            <div class="buttons">
                <a href="#"
                   class="button-green">온라인 신청하기
                </a>
                <a href="#"
                   class="button-green-outline">신청내역 보기
                </a>
            </div>
        <% } %>

        <% if (content === 'fair') { %>
            <%
                const boxItems = [
                    ['출품자', '아무개'],
                    ['지역', '서울'],
                    ['연락처', '010-0000-0000'],
                    ['출품식물', '식물 이름'],
                ];
            %>
            <div class="box green">
                <ul class="box-title-info">
                    <% for(let i = 0; i < boxItems.length; i++) { %>
                        <li>
                            <strong><%= boxItems[i][0] %></strong>
                            <span><%= boxItems[i][1] %></span>
                        </li>
                    <% } %>
                </ul>
            </div>
            <div class="detail-section">
                <strong>국내육성품종</strong>
                <table class="table-gray">
                    <colgroup>
                        <col style="width:234px">
                        <col style="width: 347px">
                        <col style="width: auto">
                    </colgroup>
                    <thead>
                    <tr>
                        <th>국명</th>
                        <th>품종명</th>
                        <th>학명</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>일월비비추</td>
                        <td>퍼스트벨</td>
                        <td>Pseudolysimachion longifolium (L.) Opiz</td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="detail-section">
                <strong>자생식물</strong>
                <table class="table-gray">
                    <colgroup>
                        <col style="width: 357px">
                        <col style="width: auto">
                    </colgroup>
                    <thead>
                    <tr>
                        <th>국명</th>
                        <th>학명</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>일월비비추</td>
                        <td>Pseudolysimachion longifolium (L.) Opiz</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        <% } %>
        <% if (content === 'qna') { %>
            <p class="desc">
                예산군농업기술센터는 지난 9월 15일부터 10월 14일까지 한 달간 관내 아파트 3개소를 대상으로 총 6회에 걸쳐 ‘찾아가는 반려식물 돌봄치유 사업’을 운영했다.
                <br>이번 사업은 공동주택 거주 어르신 20명을 대상으로 반려식물 교육과 치유활동을 결합해 정서적 안정과 실내 식물 관리 능력 향상을 돕기 위해 추진됐다.
                <br>예산군농업기술센터는 지난 9월 15일부터 10월 14일까지 한 달간 관내 아파트 3개소를 대상으로 총 6회에 걸쳐 ‘찾아가는 반려식물 돌봄치유 사업’을 운영했다.
                <br>이번 사업은 공동주택 거주 어르신 20명을 대상으로 반려식물 교육과 치유활동을 결합해 정서적 안정과 실내 식물 관리 능력 향상을 돕기 위해 추진됐다.

                <br><br>센터는 전문 강사를 아파트 단지로 직접 파견해 화분 관리법, 병해충 방제법 등 생활 속 실천 가능한 식물 돌봄 요령을 교육했다.
                <br>이와 함께 ‘꽃 화분 만들기’, ‘접시정원 만들기’ 등 실습 중심의 프로그램을 운영해 어르신들의 참여와 호응을 이끌어냈다.
                <br>특히 식물을 직접 심고 가꾸며 대화를 나누는 시간이 치유의 매개가 되면서, 참여 어르신들은 “식물을 키우며 외로움이 줄고 집안 분위기도 한층 밝아졌다”,
                <br>“화분 관리법을 배우니 식물이 훨씬 잘 자라서 뿌듯하다”는 소감을 전했다.
            </p>
            <span class="img-wrap">
            <%- include(`${process.env.INCLUDE_PATH}/components/_image`, {
            width: 966,
            height: 659,
            isSimply: true,
            source: `${imgPath}/dummy-qna.png`,
            alt: '이동형 반려식물 Q&A',
            }); %>
            </span>
            <div class="files">
                <strong>첨부파일</strong>
                <ul>
                    <li>
                        <a href="#">사업자등록 및 인·허가 관련 통합 폐업신고서.hwpx</a>
                    </li>
                    <li>
                        <a href="#">사업자등록 및 인·허가 관련 통합.hwpx</a>
                    </li>
                    <li>
                        <a href="#">사업자등록 및 인·허가 관련 통합 폐업신고서.hwpx</a>
                    </li>
                    <li>
                        <a href="#">사업자등록 및 인·허가 관련 통합.hwpx</a>
                    </li>
                </ul>
            </div>
        <% } %>
    </div>
    <% if (content !== 'qna') { %>
        <button type="button"
                class="button-navy">
            목록
        </button>
    <% } %>
    <% if (content === 'qna') { %>
        <div class="buttons">
            <button type="button" class="button-navy">수정</button>
            <button type="button" class="button-gray">삭제</button>
            <a href="#" class="button-navy">목록</a>
        </div>
    <% } %>
</div>