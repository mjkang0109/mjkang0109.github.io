        $("#fcltForm").attr("method", "post");
        $("#fcltForm").submit();
    }

    //돌봄시설 탭 이동
    function fnMvPage(val) {
        $(".moreBtn").attr('href', "/wjioncare/user/chilCare/careInfo/BD_selectCareFcltInfoList.do?fcltClsfCdList=" + val);
    }

    //돌봄시설 검색
    function fnSearch() {
        $("#dataForm").attr("action", "/wjioncare/user/chilCare/careInfo/BD_selectCareFcltInfoList.do");
        $("#dataForm").attr("method", "post");
        $("#dataForm").submit();
    }

    //연령 세팅
    function fnChilAgeSet(age) {
        $("#q_chilAge").val(age.replace("세", ""));
    }

    //분류 세팅
    function fnSearchConSet(cdId, se) {
        var prefix = (se === "E") ? "emd" : "fclt";
        var name = (se === "E") ? "emdCdList" : "fcltClsfCdList";

        if (cdId !== "") {
            var $target = $("#" + prefix + "Set_" + cdId);
            var hiddenId = "#" + prefix + "Cd_" + cdId;
            var title = $target.attr('title');

            if ($target.hasClass("active")) {
                $target.removeClass("active")
                    .attr("aria-pressed", "false");
                $(hiddenId).remove();
                $target.attr('title', title.replace(' 선택', ''));
            } else {
                $target.addClass("active")
                    .attr("aria-pressed", "true");
                $("#dataForm").append(
                    '<input type="hidden" id="' + prefix + 'Cd_' + cdId + '" name="' + name + '" value="' + cdId + '" />'
                );
                $target.attr('title', title.replace('(', ' 선택('));
            }
        } else {
            $("[id^='" + prefix + "Cd_']").remove();
            $("[id^='" + prefix + "Set_']").removeClass("active")
                .attr("aria-pressed", "false");
        }
    }
</script>
<script type="text/javascript">
    $(function () {
        function updateTabFocus() {
            $(".mMain3 .tabCont, .mMain5 .tabCont").each(function () {
                const $panel = $(this);
                const $focusables = $panel.find("a, button, input, select, textarea, [tabindex]").not("[disabled]");

                if ($panel.hasClass("hidden")) {
                    // hidden이면 tabindex=-1 부여
                    $focusables.each(function () {
                        const $el = $(this);
                        if (!$el.data("orig-tabindex")) {
                            $el.data("orig-tabindex", $el.attr("tabindex") || "none");
                        }
                        $el.attr("tabindex", -1);
                    });
                    $panel.attr("aria-hidden", "true");
                } else {
                    // 보이면 원래 tabindex 복원
                    $focusables.each(function () {
                        const $el = $(this);
                        const orig = $el.data("orig-tabindex");
                        if (orig) {
                            if (orig === "none") $el.removeAttr("tabindex");
                            else $el.attr("tabindex", orig);
                            $el.removeData("orig-tabindex");
                        } else if ($el.attr("tabindex") === "-1") {
                            $el.removeAttr("tabindex");
                        }
                    });
                    $panel.removeAttr("aria-hidden");
                }
            });
        }

        // 초기 실행
        updateTabFocus();

        // 탭 전환 링크 클릭 시 실행 (기존 onclick 실행된 후에)
        $(".mMain3 .jsTab1 a, .mMain5 .jsTab1 a").on("click", function () {
            setTimeout(updateTabFocus, 0);
        });
    });
</script>-->