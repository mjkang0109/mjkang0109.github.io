<%
var items = items || [];
var title = title || '';
var category = category || '';
var bottomCaution = bottomCaution || '';
var onlyCaution = onlyCaution || '';
%>
<article class="detail-section">
    <% if (onlyCaution) { %>
    <strong class="title-none"><%- onlyCaution; %></strong>
    <% } %>
    <% if (!onlyCaution) { %>
    <strong class="<%= category === 'clinic' ? 'title-leaves' : ''; %>"><%- title; %></strong>
    <% } %>
    <ul class="item-horizon">
        <%
        items.map((b, i) => {
        %>
            <li>
                <strong><%- b[0]; %></strong>
                <% if (b[1]) { %>
                    <div class="<%= b[1] === 'address' ? 'address' : b[1] === 'period' ? 'period' : b[1] === 'file' ? 'file' : ''; %>">
                        <% if (typeof b[1] === 'string' && b[1] !== 'address' && b[1] !== 'period' && !b[1].toLowerCase().includes('file') && b[1] !== 'textarea') { %>
                            <%- b[1]; %>
                        <% } %>
                        <% if (b[1] === 'address') { %>
                            <label for="address1">
                                <input type="text"
                                       id="address1"
                                       class="it"
                                       disabled>
                            </label>
                            <button type="button"
                                    class="button-black">
                                주소찾기
                            </button>
                            <label for="address2">
                                <input type="text"
                                       id="address2"
                                       class="it"
                                       disabled>
                            </label>
                            <label for="address3">
                                <input type="text"
                                       id="address3"
                                       class="it"
                                       placeholder="상세주소를 입력하세요.">
                            </label>
                        <% } %>
                        <% if (b[1] === 'period') { %>
                            <label for="dateStart">
                                <input type="text"
                                       id="dateStart"
                                       autocomplete="off"
                                       class="it jsDatepicker">
                            </label>
                            <span>~</span>
                            <label for="dateEnd">
                                <input type="text"
                                       id="dateEnd"
                                       autocomplete="off"
                                       class="it jsDatepicker">
                            </label>
                        <% } %>
                        <% if (b[1] === 'textarea') { %>
                            <label for="textarea1">
                                <textarea id="textarea1"></textarea>
                            </label>
                        <% } %>
                        <% if (b[1] === 'file') { %>
                            <ul class="box outline">
                                <li>
                                    <button type="button"
                                            class="button-delete">
                                        <span class="sound-only">삭제</span>
                                    </button>
                                    <span>한국수목원정원관리원_sample_file.xlsx (13 KB)</span>
                                </li>
                                <li>
                                    <button type="button"
                                            class="button-delete">
                                        <span class="sound-only">삭제</span>
                                    </button>
                                    <span>한국수목원정원관리원_sample_file.xlsx (13 KB)</span>
                                </li>
                                <li>
                                    <button type="button"
                                            class="button-delete">
                                        <span class="sound-only">삭제</span>
                                    </button>
                                    <span>한국수목원정원관리원_sample_file.xlsx (13 KB)</span>
                                </li>
                            </ul>
                            <div class="buttons">
                                <button type="button"
                                        class="button-navy small">
                                    파일선택
                                </button>
                                <button type="button"
                                        class="button-navy small">
                                    모두삭제
                                </button>
                            </div>
                            <p class="caution">
                                ※ 첨부파일 제한용량 : 50 MB
                                <br>※ 허용파일 유형 : gif, jpg, png, jpeg
                            </p>
                        <% } %>
                        <% if (b[1] === 'singleFile') { %>
                            <button type="button"
                                    class="button-navy small">
                                파일선택
                            </button>
                            <span class="file-wrap">
                            <span>한국수목원정원관리원_sample_file.xlsx (13 KB)</span>
                                <button type="button"
                                        class="button-delete">
                                    <span class="sound-only">삭제</span>
                                </button>
                            </span>
                            <strong class="caution">※ 신청자 본인 얼굴 정면이 나온 사진 등록</strong>
                        <% } %>
                        <% if (typeof b[1] === 'object') {
                            const type = b[1][0];
                        if (type === 'select') { %>
                            <label for="<%= category; %>-select<%= i + 1; %>"
                                   class="<%= b[1][2] ? b[1][2] : '' %>">
                                <select id="<%= category; %>-select<%= i + 1; %>"
                                        class="select">
                                    <% for (let j = 1; j < b[1].length; j++) { %>
                                    <% if (b[1][j] === 'middle') {
                                        continue;
                                    } %>
                                        <option value=""><%= b[1][j] %></option>
                                    <% } %>
                                </select>
                            </label>
                        <% } %>
                        <% if (type === 'radio') { %>
                            <%
                            b[1][1].map((radio, j) => { %>
                                <input type="radio"
                                       id="<%= category; %>-radio<%= j + 1; %>"
                                        <%- j === 0 ? `checked` : '' %>
                                       name="<%= category %>-radio<%= i; %>">
                                <label for="<%= category; %>-radio<%= j + 1; %>">
                                    <%= radio; %>
                                </label>
                        <% });
                        } %>
                        <% if (type === 'checkbox') { %>
                            <%
                            b[1][1].map((check, j) => { %>
                                <input type="checkbox"
                                       id="<%= category %>-check<%= j + 1; %>"
                                       name="check<%= i; %>">
                                <label for="<%= category %>-check<%= j + 1; %>">
                                    <%= check; %>
                                </label>
                                <% if (check === '기타') { %>
                                    <label for="<%= category %>-radio-input<%= j + 1 %>">
                                        <input type="text"
                                               id="<%= category %>-radio-input<%= j + 1 %>"
                                               class="it"
                                               placeholder="텍스트를 입력하세요">
                                    </label>
                                <% } %>
                        <% });
                        } %>
                        <% if (type === 'input') { %>
                            <label for="<%= category %>-input<%= i + 1 %>-1"
                                   class="<%= b[1][2] ? b[1][2] : '' %>">
                                <input type="text"
                                       id="<%= category %>-input<%= i + 1 %>-1"
                                       class="it"
                                        <%- b[1][3] === 'disabled' ? 'disabled' : '' %>
                                       placeholder="<%- b[1][1] %>">
                            </label>
                        <% } %>
                        <% } %>
                        <% if (b.length === 3) { %>
                            <%- b[2] %>
                        <% } %>
                    </div>
                <% } %>
                <% if (b[2] && b.length !== 3) { %>
                    <strong>
                        <%- b[2]; %>
                    </strong>

                    <% if (b[2].includes('사업자등록번호')) { %>
                        <div class="business">
                            <% for (let z = 0; z < 3; z++) { %>
                                <% if (z !== 0) { %>
                                    <span>-</span>
                                <% } %>
                                <label for="<%= category %>-input<%= i %>-<%= z + 1 %>">
                                    <input type="text"
                                           class="it"
                                           id="<%= category %>-input<%= i %>-<%= z + 1 %>">
                                </label>
                            <% } %>
                        </div>
                    <% } %>
                <% } %>
                <% if (b[3]) { %>
                    <div>
                        <% if (typeof b[3] === 'string') { %>
                            <%= b[3]; %>
                        <% } %>
                        <% if (typeof b[3] === 'object') {
                            const type = b[3][0];
                        if (type === 'input') {
                        %>
                            <label for="<%= category %>-input<%= i + 1 %>-2"
                                   class="<%= b[3][2] ? b[3][2] : '' %>">
                                <input type="text"
                                       id="<%= category %>-input<%= i + 1 %>-2"
                                       class="it"
                                       placeholder="<%- b[3][1] %>">
                            </label>
                        <% } %>

                        <% if (type === 'button') { %>
                            <button type="button"
                                    class="<%= b[3][2]%>">
                                <%= b[3][1] %>
                            </button>
                        <% } %>
                        <% } %>
                    </div>
                <% } %>
            </li>
        <% }); %>
    </ul>

    <% if (bottomCaution) { %>
        <p class="caution"><%= bottomCaution %></p>
    <% } %>
</article>
