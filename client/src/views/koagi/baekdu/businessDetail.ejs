---
group: baekdu
state:
    default: 산림생물자원조사
    business2: 산림생물자원보전연구
    business3: 산림복원연구
---
<!DOCTYPE html>
<html lang="ko">
<head>
    <%
    currentName = '국립백두대간수목원';
    currentCategory = 'baekdu';
    currentNav = 'research';
    imgPath = `${process.env.IMG_PATH}/koagi`
    %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_head`, {
    title: currentName,
    currentCategory: currentCategory
    }); %>
</head>
<body class="<%= currentCategory %>">
    <!-- skip navigation -->
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_skipNavigation`) %>
    <!-- // skip navigation -->

    <!-- wrap -->
    <div id="wrap">
        <!-- header -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_header`, {
        currentCategory,
        currentNav,
        currentName
        }) %>
        <!-- // header -->

        <!-- visual sub -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_visualSub`, {
        type: 'plant',
        currentNav: '산림연구',
        key: '국민이 행복한 수목원',
        info: '산림생물다양성 보전과 활용의 중심인 국립백두대간수목원에서<br>산림가치 증진을 통해 국민이 행복한 수목원을 만들어 나가겠습니다',
        }) %>
        <!-- // visual sub -->

        <!-- title -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_titleSub`, {
        title: state === 'default' ? '산림생물자원 조사' : state === 'business2' ? '산림생물자원 보전 연구' : '산림복원 연구',
        desc: state === 'default' ? '백두대간보호구역 조사 및 보전 기반 구축' : state === 'business2' ? '' : '산림생물자원의 유용소재 발굴',
        depths: [
        '산림연구',
        '연구사업',
        '현지 내 보전',
        state === 'default' ? '산림생물자원 조사' : state === 'business2' ? '산림생물자원 보전 연구' : '산림복원 연구',
        ],
        }) %>
        <!-- // title -->

        <!-- contents -->
        <div id="body">
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_businessDetail`, {

            }) %>
        </div>
        <!-- // contents -->

        <!-- footer -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_footer`, {
        currentName,
        currentCategory,
        }) %>
        <!-- // footer -->

        <!-- navigation -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_navigation`, {
        currentCategory: currentCategory
        }) %>
        <!-- // navigation -->
    </div>
    <!-- // wrap -->
</body>
</html>