---
group: sejong
state:
    default: 가든샵
---
<!DOCTYPE html>
<html lang="ko">
<head>
    <%
    currentName = '국립세종수목원';
    currentCategory = 'sejong';
    currentNav = 'viewing';
    imgPath = `${process.env.IMG_PATH}/koagi`
    %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_head`, {
        title: currentName,
        currentCategory: currentCategory
    }); %>
</head>
<body class="<%= currentCategory %>">
    <!-- skip navigation -->
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_skipNavigation`) %>
    <!-- // skip navigation -->

    <!-- wrap -->
    <div id="wrap">
        <!-- header -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_header`, {
            currentCategory,
            currentNav,
            currentName
        }) %>
        <!-- // header -->

        <!-- visual sub -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_visualSub`, {
            type: 'plant',
            currentNav: '관람안내',
            key: '국민이 행복한 수목원',
            info: '산림생물다양성 보전과 활용의 중심인 국립백두대간수목원에서<br>산림가치 증진을 통해 국민이 행복한 수목원을 만들어 나가겠습니다',
        }) %>
        <!-- // visual sub -->

        <!-- title -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_titleSub`, {
            title: '가든샵',
            desc: '우리 수목원은 방문자에게 좀 더 편리하고 유익한 환경을 제공하고자 노력하고 있습니다.',
            depths: [
                '관람안내',
                '시설안내',
                '가든샵'
            ],
        }) %>
        <!-- // title -->

        <!-- contents -->
        <div id="body">
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_tab`, {
            items: ['가든샵 소개', '입점안내']
            }) %>

            <%
            const detailItems = [
                {
                    title: '위치',
                    desc : '방문자센터 1층',
                },
                {
                    title: '운영시간',
                    desc : '09:00 ~ 17:30',
                },
                {
                    title: '설명',
                    desc : '커피(아메리카노, 카페라떼, 바닐라라떼), 허브티(캐모마일, 루이스보스), 라즈베리 블랙티, 유자차, 생강차, 그린티라떼, 미숫가루라떼, 자몽에이드, 레몬에이드, 복숭아아이스티, 레몬아이스티, 핫초코, 아이스초코',
                },
            ];
            %>
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_detail`, {
            title: '가든샵',
            dummy: 'food',
            items: detailItems,
            hideListLink: true,
        }) %>
            
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_foldItems`, {
                
            }) %>

        </div>
        <!-- // contents -->

        <!-- footer -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_footer`, {
            currentCategory,
            currentName,
        }) %>
        <!-- // footer -->

        <!-- navigation -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_navigation`, {
            currentCategory: currentCategory
        }) %>
        <!-- // navigation -->
    </div>
    <!-- // wrap -->
</body>
</html>