---
group: sejong
state:
    default: 온대중부식물연구-소개
    conservation: 온대중부식물연구-보전
    utilization: 온대중부식물연구-활용
---
<!DOCTYPE html>
<html lang="ko">
<head>
    <%
    currentName = '국립세종수목원';
    currentCategory = 'sejong';
    currentNav = 'research';
    imgPath = `${process.env.IMG_PATH}/koagi`;
    %>
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_head`, {
    title: currentName,
    currentCategory: currentCategory
    }); %>
</head>
<body class="<%= currentCategory ;%>">
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_businessItems`, {
    }) %>
    <!-- skip navigation -->
    <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_skipNavigation`) %>
    <!-- // skip navigation -->
    <!-- wrap -->
    <div id="wrap">
        <!-- header -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_header`, {
        currentCategory,
        currentNav,
        currentName
        }) %>
        <!-- // header -->
        <!-- visual sub -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_visualSub`, {
        type: 'plant',
        currentNav: '식물연구',
        key: '국민이 행복한 수목원',
        info: '산림생물다양성 보전과 활용의 중심인 국립백두대간수목원에서<br>산림가치 증진을 통해 국민이 행복한 수목원을 만들어 나가겠습니다',
        }) %>
        <!-- // visual sub -->
        <!-- title -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_titleSub`, {
        title: '온대중부식물연구',
        depths: [
        '식물연구',
        '온대식물연구',
        ],
        }) %>
        <!-- // title -->
        <!-- contents -->
        <div id="body">
            <%
            const items = ['소개', '보전', '활용'];
            const currentIndex = items.findIndex((item, i) => {
                if (pageFm.state[state].includes(item)) {
                    return true;
                }
            });
            %>
            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_tab`, {
            items: ['소개', '보전', '활용'],
            current: currentIndex,
            }) %>

            <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_temp`, {
                
            }) %>
        </div>
        <!-- // contents -->
        <!-- footer -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_footer`, {
        currentName,
        currentCategory,
        }) %>
        <!-- // footer -->
        <!-- navigation -->
        <%- include(`${process.env.INCLUDE_PATH}/koagi/partials/_navigation`, {
        currentCategory: currentCategory
        }) %>
        <!-- // navigation -->
    </div>
    <!-- // wrap -->
</body>
</html>